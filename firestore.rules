rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile rules: Only the authenticated user can read or write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Products rules: Any authenticated B2B partner can read products
    match /products/{productId} {
      allow read: if request.auth != null;
      // Allow write/update for automatic catalog seeding in demo mode
      allow write: if request.auth != null;
    }
    
    // Try-on transactions logging rules: Users can read and write only their own logs
    match /try_ons/{tryOnId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Prevent updating or deleting logged transactions to ensure audit integrity
      allow update, delete: if false;
    }
  }
}
