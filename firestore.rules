rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile and subcollections: Only the authenticated owner can access
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /cart/{cartId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /wishlist/{wishlistId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Products rules: Any authenticated user can read; client writes are restricted
    match /products/{productId} {
      allow read: if request.auth != null;
      // Allow write only by admin or initial catalog seeding
      allow write: if request.auth != null && (request.auth.token.admin == true || !exists(/databases/$(database)/documents/products/$(productId)));
    }
    
    // Try-on transactions logging rules: Users can read and write only their own logs
    match /try_ons/{tryOnId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Prevent updating or deleting logged transactions to ensure audit integrity
      allow update, delete: if false;
    }

    // 3D Mesh Render jobs: Users can create and monitor their own asynchronous tasks
    match /3d_renders/{renderId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      // Step progression and final outputs are written exclusively by Cloud Functions Admin SDK
      allow update, delete: if false;
    }
  }
}
